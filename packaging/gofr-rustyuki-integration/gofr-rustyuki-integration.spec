Name:           gofr-rustyuki-integration
Version:        45.0.0
Release:        1%{?dist}
Summary:        RustyUKI integration defaults and utilities for GOFR
License:        MIT
URL:            https://github.com/GlitchSlayed/GOFR
BuildArch:      noarch

Requires:       rustyuki >= 0.2.0
Requires:       gofr-boot
Requires:       dracut
Requires:       systemd-ukify
Requires:       systemd-boot

%description
Configures RustyUKI distribution defaults for GOFR, ensuring Btrfs subvolume
rootflags and systemd-boot integration are active on newly provisioned kernels.

%prep
# No prep required

%build
# No build required

%install
mkdir -p %{buildroot}%{_sbindir}
mkdir -p %{buildroot}%{_sysconfdir}/kernel

# Fallback kernel commandline if not already generated by installer
cat << 'EOF' > %{buildroot}%{_sysconfdir}/kernel/cmdline.gofr-template
rootflags=subvol=@ ro quiet rhgb splash
EOF

# Helper script for offline image UKI generation or manual reconciliation
cat << 'EOF' > %{buildroot}%{_sbindir}/gofr-uki-reconcile
#!/usr/bin/env bash
set -euo pipefail

SYSROOT="${1:-}"
EXTRA_ARGS=()

if [ -n "${SYSROOT}" ]; then
    EXTRA_ARGS+=(--sysroot "${SYSROOT}")
fi

echo "Running RustyUKI reconciliation for GOFR..."
exec /usr/bin/rustyuki "${EXTRA_ARGS[@]}" reconcile
EOF
chmod 0755 %{buildroot}%{_sbindir}/gofr-uki-reconcile

%post
if [ ! -s %{_sysconfdir}/kernel/cmdline ] && [ -f %{_sysconfdir}/kernel/cmdline.gofr-template ]; then
    cp %{_sysconfdir}/kernel/cmdline.gofr-template %{_sysconfdir}/kernel/cmdline
fi

%files
%config(noreplace) %{_sysconfdir}/kernel/cmdline.gofr-template
%{_sbindir}/gofr-uki-reconcile

